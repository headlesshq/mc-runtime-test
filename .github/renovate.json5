{
  extends: [
    ':enableRenovate',
    ':semanticCommits',
    ':enablePreCommit',
    'config:best-practices',
  ],
  timezone: 'UTC',
  dependencyDashboard: true,
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  enabledManagers: [
    'github-actions',
    'devcontainer',
    'nix',
  ],
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
    {
      matchManagers: [
        'nix',
      ],
      groupName: 'nix flake inputs',
      schedule: [
        'on the first day of the month',
      ],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
      automerge: false,
    },
  ],
}
